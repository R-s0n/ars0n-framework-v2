# Supply-chain hardening for this package. The Docker build runs `npm ci` against the committed
# package-lock.json, so these settings mostly guard local `npm install` runs that change the lock.
#
# ignore-scripts: no dependency gets to run install/postinstall hooks (the Shai-Hulud worms spread
#   that way). Nothing in this tree needs one; fsevents is macOS-only and optional.
# min-release-age: refuse any version published fewer than 7 days ago, so a hijacked release has
#   time to be caught and pulled before it can land in the lock. Needs npm >= 11.10; npm 10 ignores
#   it silently. npm before 11.15 (e.g. 11.11) refuses it together with --before, so to regenerate
#   the lock run `npm install --package-lock-only` and let this setting provide the cooldown.
# allow-git / allow-remote: dependencies may only come from the registry, never from a git URL or a
#   tarball URL. allow-git needs npm >= 11.9. allow-remote needs npm >= 11.15 (added in 11.14;
#   11.15 fixed how allow-remote=none treats registry tarballs); older npm, including 11.11, warns
#   "Unknown project config" and ignores it. The Docker build's npm (11.19.1, bundled with
#   Node 24.22.1) enforces both.
#
# legacy-peer-deps is gone: react-window 1.8.11 accepts React 19, so peer dependencies now resolve
# normally.
ignore-scripts=true
min-release-age=7
allow-git=none
allow-remote=none
