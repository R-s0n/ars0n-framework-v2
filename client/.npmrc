# The project runs on React 19. Some well-maintained, runtime-compatible deps (e.g. react-window)
# still declare a peer range that caps at React 18, which makes npm 7+ fail `npm install` with
# ERESOLVE. Relax peer-dep enforcement so installs succeed; these libraries work on React 19 at
# runtime (they only use stable React APIs). Added for G1.5 (react-window virtualization).
legacy-peer-deps=true
