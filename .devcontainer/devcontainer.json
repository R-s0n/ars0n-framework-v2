{
  "name": "Ars0n Framework v2",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-22.04",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "version": "latest",
      "moby": false,
      "dockerDashComposeVersion": "v2"
    }
  },
  "onCreateCommand": "docker compose up -d --build 2>&1 | tee /tmp/docker-build.log && echo 'Build complete'",
  "postStartCommand": "docker compose ps | grep -q 'Up' || docker compose up -d",
  "forwardPorts": [80],
  "portsAttributes": {
    "80": {
      "label": "Ars0n Framework UI",
      "onAutoForward": "openBrowser",
      "visibility": "public"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-azuretools.vscode-docker"
      ]
    }
  }
}
